---
import { getProcessSteps } from "../lib/queries";
const steps = await getProcessSteps();
---
<section id="process" class="section">
  <div class="container-page">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="badge"><span class="badge-dot"></span> How We Work</span>
      <h2 class="mt-6 text-4xl md:text-5xl font-extrabold tracking-[-0.035em] text-white">
        Marketing that works in <span class="text-gradient-bp">4 steps</span>
      </h2>
      <p class="mt-5 text-lg text-white/65 leading-relaxed">
        No black box, no jargon. A predictable rhythm that delivers month after month.
      </p>
    </div>
    <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5 reveal-stagger">
      {steps.map((s, i) => (
        <div class="card relative reveal tilt shine-card" style={"--i:" + i}>
          <div class="grid place-items-center w-12 h-12 rounded-xl text-white font-bold mb-5 transition-transform duration-300 group-hover:scale-110"
               style={"background:linear-gradient(135deg," + s.fromCss + " 0%," + s.toCss + " 100%);box-shadow:0 12px 28px -12px " + s.fromCss + "AA;"}>{s.n}</div>
          <h3 class="text-xl font-bold mb-3 text-white">{s.title}</h3>
          <p class="text-sm text-white/65 leading-relaxed">{s.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
