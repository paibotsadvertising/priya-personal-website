---
interface Props { variant?: "dark" | "light"; size?: "sm" | "md" | "lg"; }
const { size = "md" } = Astro.props;
// Logo aspect 682x202 ≈ 3.38:1
const heightMap: Record<string, string> = { sm: "h-10", md: "h-14", lg: "h-20" };
const heightClass = heightMap[size];
---
<a href="/" aria-label="PaiBots Advertising home" class="inline-flex items-center leading-none">
  <img
    src="/images/paibots-logo.png"
    alt="PaiBots Advertising"
    class={heightClass + " w-auto"}
    width="682" height="202"
    decoding="async"
  />
</a>
