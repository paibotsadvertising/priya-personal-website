---
import { getResults } from "../lib/queries";
const wins = await getResults();
---
<section id="results" class="section">
  <div class="container-page">
    <div class="text-center max-w-3xl mx-auto mb-14">
      <span class="badge"><span class="badge-dot" style="background:#EC4899;box-shadow:0 0 10px rgba(236,72,153,.6);"></span> Results</span>
      <h2 class="mt-6 text-4xl md:text-5xl font-extrabold tracking-[-0.035em] text-white">
        Real brands. <span class="text-gradient-bp">Real numbers.</span>
      </h2>
      <p class="mt-5 text-lg text-white/65 leading-relaxed">
        A few of the brands we've grown — names hidden under NDA, screenshots on request.
      </p>
    </div>
    <div class="grid md:grid-cols-3 gap-6 reveal-stagger">
      {wins.map((w, i) => (
        <div class="card !p-8 reveal tilt shine-card" style={"--i:" + i}>
          <span class="badge text-xs">{w.tag}</span>
          {w.count ? (
            <div class="mt-6 text-5xl font-extrabold tracking-[-0.04em]"
                 style={"background:linear-gradient(90deg," + w.fromCss + "," + w.toCss + ");-webkit-background-clip:text;background-clip:text;color:transparent;"}
                 data-count-to={w.count.to}
                 data-count-prefix={w.count.prefix}
                 data-count-suffix={w.count.suffix}>{w.count.prefix}0{w.count.suffix}</div>
          ) : (
            <div class="mt-6 text-5xl font-extrabold tracking-[-0.04em]"
                 style={"background:linear-gradient(90deg," + w.fromCss + "," + w.toCss + ");-webkit-background-clip:text;background-clip:text;color:transparent;"}>{w.metric}</div>
          )}
          <div class="text-sm text-white/55 mt-1.5">{w.metricLabel}</div>
          <p class="mt-6 text-sm text-white/70 leading-relaxed">{w.body}</p>
        </div>
      ))}
    </div>
    <div class="text-center mt-12 reveal">
      <a href="#contact" class="btn btn-soft btn-lg">Want results like these? Talk to us →</a>
    </div>
  </div>
</section>
