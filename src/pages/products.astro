---
import Base from "../layouts/Base.astro";
import Products from "../components/Products.astro";
import CTASection from "../components/CTASection.astro";
import { SITE } from "../lib/site";

const title = "Products — " + SITE.name;
const description = "Fixed-scope, fixed-price digital marketing products you can buy in a click.";
---
<Base title={title} description={description}>
  <section class="relative overflow-hidden pt-24 pb-6">
    <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[900px] h-[600px] pointer-events-none"
         style="background:radial-gradient(closest-side,#10B98144 0%, transparent 70%);filter:blur(40px);"></div>
    <div class="container-page relative max-w-3xl text-center">
      <a href="/" class="text-sm text-white/60 hover:text-white">&larr; Back to home</a>
      <h1 class="mt-6 text-4xl md:text-6xl font-extrabold leading-[1.05] tracking-[-0.04em]">
        <span class="text-gradient">Buy a Product</span>
      </h1>
      <p class="mt-5 text-lg text-white/70">
        Skip the proposal. Pick a package, pay securely, and we get started the next business day.
      </p>
    </div>
  </section>
  <Products />
  <CTASection />
</Base>
