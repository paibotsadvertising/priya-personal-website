---
// Mirrors Figma's hero: badge → massive gradient text → dual CTAs → stats grid
---
<section class="relative overflow-hidden pt-28 pb-32">
  <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[1100px] h-[700px] pointer-events-none orb-drift-1"
       style="background:radial-gradient(closest-side, rgba(99,102,241,.35) 0%, rgba(168,85,247,.12) 45%, transparent 70%); filter:blur(40px);"></div>
  <div class="absolute top-20 -left-40 w-[600px] h-[600px] pointer-events-none orb-drift-2"
       style="background:radial-gradient(closest-side, rgba(236,72,153,.22) 0%, rgba(244,63,94,.08) 45%, transparent 70%); filter:blur(50px);"></div>
  <div class="absolute top-40 -right-40 w-[600px] h-[600px] pointer-events-none orb-drift-1"
       style="background:radial-gradient(closest-side, rgba(6,182,212,.22) 0%, rgba(16,185,129,.08) 45%, transparent 70%); filter:blur(50px); animation-delay:-6s;"></div>

  <div class="absolute inset-0 pointer-events-none overflow-hidden">
    <span class="particle" style="left:12%; bottom:10%; animation-delay:0s;"></span>
    <span class="particle" style="left:24%; bottom:18%; animation-delay:1.4s; width:4px; height:4px;"></span>
    <span class="particle" style="left:38%; bottom:6%;  animation-delay:3.1s;"></span>
    <span class="particle" style="left:52%; bottom:22%; animation-delay:4.6s; width:5px; height:5px;"></span>
    <span class="particle" style="left:66%; bottom:12%; animation-delay:2.2s;"></span>
    <span class="particle" style="left:78%; bottom:20%; animation-delay:5.8s; width:4px; height:4px;"></span>
    <span class="particle" style="left:88%; bottom:8%;  animation-delay:6.7s;"></span>
  </div>

  <div class="container-page relative text-center max-w-5xl mx-auto">
    <div class="fade-up flex justify-center">
      <div class="cred-strip" aria-label="Agency performance highlights">
        <span class="cred-spark" aria-hidden="true">⚡</span>
        <span class="cred-item">
          <span class="cred-num"><span data-count-to="4.2" data-count-decimals="1" data-count-prefix="₹" data-count-suffix=" Cr+" data-count-duration="1600">₹0 Cr+</span></span>
          <span class="cred-label">ad spend managed</span>
        </span>
        <span class="cred-sep" aria-hidden="true"></span>
        <span class="cred-item">
          <span class="cred-num"><span data-count-to="180" data-count-decimals="0" data-count-suffix="+" data-count-duration="1600">0+</span></span>
          <span class="cred-label">brands grown</span>
        </span>
        <span class="cred-sep" aria-hidden="true"></span>
        <span class="cred-item">
          <span class="cred-num"><span data-count-to="3.2" data-count-decimals="1" data-count-suffix="×" data-count-duration="1600">0×</span></span>
          <span class="cred-label">avg ROAS</span>
        </span>
        <span class="cred-sep" aria-hidden="true"></span>
        <span class="cred-item">
          <span class="cred-num">24/7</span>
          <span class="cred-label">monitoring</span>
        </span>
      </div>
    </div>

    <span class="badge fade-up delay-1 mt-5"><span class="badge-dot pulse-dot"></span> Premium Digital Marketing Solutions</span>

    <h1 class="mt-8 text-5xl sm:text-6xl md:text-7xl lg:text-8xl font-extrabold leading-[1.02] tracking-[-0.04em] fade-up delay-2">
      <span class="text-shimmer">Elevate Your</span><br/>
      <span class="word-rotate" aria-live="polite">
        <span class="text-gradient-bp word-rotate__item" data-rotator>Digital Presence</span><span class="caret-blink" aria-hidden="true"></span>
      </span>
    </h1>

    <p class="mt-8 text-lg md:text-xl text-white/65 max-w-2xl mx-auto leading-relaxed fade-up delay-3">
      Transform your brand with cutting-edge digital marketing strategies. From quick wins to comprehensive campaigns, we deliver results that matter.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3 fade-up delay-4">
      <a href="#contact" class="btn btn-primary btn-lg btn-shine">Get Started <span aria-hidden="true" class="arrow-nudge">→</span></a>
      <a href="#results" class="btn btn-ghost btn-lg">View Our Work</a>
    </div>

    <div class="mt-20 grid grid-cols-2 md:grid-cols-4 gap-4 max-w-4xl mx-auto">
      {[
        { v: "3.2×", l: "Avg. ROAS in 90 days",   from: "#60A5FA", to: "#A855F7", d: "delay-4", c: { to: 3.2, dec: 1, suf: "×" } },
        { v: "412",  l: "Qualified leads / mo",   from: "#EC4899", to: "#F43F5E", d: "delay-5", c: { to: 412, dec: 0, suf: "" } },
        { v: "#1",   l: "On 28 priority keywords",from: "#F59E0B", to: "#F97316", d: "delay-6", c: null },
        { v: "98%",  l: "Client retention",       from: "#10B981", to: "#06B6D4", d: "delay-7", c: { to: 98, dec: 0, suf: "%" } },
      ].map(s => (
        <div class={"card !p-5 text-center tilt fade-up " + s.d}>
          {s.c ? (
            <div class="text-3xl md:text-4xl font-extrabold tracking-tight"
                 style={"background:linear-gradient(90deg," + s.from + "," + s.to + ");-webkit-background-clip:text;background-clip:text;color:transparent;"}
                 data-count-to={s.c.to}
                 data-count-decimals={s.c.dec}
                 data-count-suffix={s.c.suf}
                 data-count-duration="1600">0{s.c.suf}</div>
          ) : (
            <div class="text-3xl md:text-4xl font-extrabold tracking-tight"
                 style={"background:linear-gradient(90deg," + s.from + "," + s.to + ");-webkit-background-clip:text;background-clip:text;color:transparent;"}>{s.v}</div>
          )}
          <div class="text-xs text-white/55 mt-2">{s.l}</div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const target = document.querySelector<HTMLElement>('[data-rotator]');
  if (target) {
    const words = ['Digital Presence', 'Brand Story', 'Ad Spend ROI', 'Lead Pipeline', 'Local Reach', 'Conversion Rate'];
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!reduce) {
      let i = 0;
      const swap = () => {
        target.classList.add('is-out');
        target.addEventListener('animationend', function handler() {
          target.removeEventListener('animationend', handler);
          i = (i + 1) % words.length;
          target.textContent = words[i];
          target.classList.remove('is-out');
          target.style.animation = 'none';
          void target.offsetWidth;
          target.style.animation = '';
        }, { once: true });
      };
      setInterval(swap, 2800);
    }
  }
</script>
